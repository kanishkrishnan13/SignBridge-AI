{
  "name": "SignBridge AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",

  // Install all Python dependencies after the container is created.
  // numpy must be pinned first to avoid version conflicts between
  // mediapipe, tensorflow, and scikit-learn.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Forward the Flask backend port so the app is reachable in the browser.
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "SignBridge AI",
      "onAutoForward": "openBrowser"
    }
  },

  // Open the app automatically when the server starts.
  "postStartCommand": "python run.py",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  }
}
